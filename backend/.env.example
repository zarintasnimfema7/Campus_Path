APP_ENV=development
FRONTEND_URL=http://localhost:3000

GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GITHUB_TOKEN=


DATABASE_URL=

# Private CV bucket (provision separately). Use Application Default Credentials:
# locally: gcloud auth application-default login
# Cloud Run: use the attached service account. Do not commit credential keys.
GCS_BUCKET_NAME=
GOOGLE_CLOUD_PROJECT=

# Existing Pub/Sub topic ID; provision separately. Uses the same ADC setup.
PUBSUB_TOPIC_ID=

# Total processing attempts including the first attempt; default 5.
WORKFLOW_MAX_RETRIES=5
